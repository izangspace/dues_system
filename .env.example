# Email Configuration
# For Gmail: Use your Gmail address and an App Password (not your regular password)
# Generate App Password: https://myaccount.google.com/apppasswords

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_FROM_NAME=Student Dues System

# For other providers:
# SendGrid: MAIL_SERVER=smtp.sendgrid.net, MAIL_PORT=587
# Outlook: MAIL_SERVER=smtp-mail.outlook.com, MAIL_PORT=587
# Yahoo: MAIL_SERVER=smtp.mail.yahoo.com, MAIL_PORT=587
